DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# Required. Copy this from Supabase Dashboard > Connect.
# For local Django development on IPv4 networks, prefer the Session pooler URL.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_CONN_MAX_AGE=60
